# ---- LLM providers (at least one required) ----
# Free option: OpenRouter — sign up at https://openrouter.ai (free tier models)
OPENROUTER_API_KEY=
# Free tier via Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free tier via Groq: https://console.groq.com
GROQ_API_KEY=

# Model selection (any LiteLLM-compatible model string)
BROKERIQ_MODEL=openrouter/google/gemini-2.5-flash
BROKERIQ_EMBEDDING_MODEL=BAAI/bge-m3
BROKERIQ_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ---- Tracing (free dev tier) ----
# https://smith.langchain.com — 5k traces/month on the free Developer plan
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=brokeriq

# ---- Local stack (docker compose) ----
POSTGRES_DSN=postgresql://brokeriq:brokeriq@localhost:5432/brokeriq
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0

# ---- Web search (zero-key default; optional Tavily) ----
TAVILY_API_KEY=

# ---- API ----
BROKERIQ_ENV=dev
BROKERIQ_LOG_LEVEL=INFO
BROKERIQ_CORPUS_DIR=data/corpus
BROKERIQ_CACHE_TTL=3600
